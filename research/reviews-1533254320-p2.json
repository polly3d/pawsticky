{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id1434976548"}, "name":{"label":"AaronMcVay"}, "label":""}, "updated":{"label":"2026-01-05T18:40:46-07:00"}, "im:rating":{"label":"2"}, "im:version":{"label":"5.0.2"}, "id":{"label":"13599956164"}, "title":{"label":"Was good"}, "content":{"label":"I was using this for a while and it was working great. I believe an update jacked it up. It now cycles through pinned notes when I unpin them. There’s also random notes that I’ve never created popping up with different languages. I unpin them and they automatically pin and pop up on their own randomly throughout the day. \n\nI’ve been paying for this app, but will be uninstalling it now.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=1533254320&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
