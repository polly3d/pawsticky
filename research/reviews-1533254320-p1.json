{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id33639573"}, "name":{"label":"timholmez"}, "label":""}, "updated":{"label":"2026-06-29T16:19:45-07:00"}, "im:rating":{"label":"4"}, "im:version":{"label":"5.0.6"}, "id":{"label":"14242805734"}, "title":{"label":"Very good"}, "content":{"label":"Great app, def enjoy the functionality. My only complaint is that when stickies are updated via shortcuts, 80% of the time the app has to be updated for the content on the widget to be refreshed. I like to update mine dynamically on a schedule throughout the day, and opening the app is just enough friction to make it annoying to use.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=1533254320&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
